<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/adjustments_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/video_adjustments_enable" />

        <TextView
            android:id="@+id/adjustments_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/brightness_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/brightness_slider"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.slider.Slider
            android:id="@+id/brightness_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/video_adjustments_brightness"
            android:stepSize="1"
            android:value="0"
            android:valueFrom="-100"
            android:valueTo="100"
            app:labelBehavior="floating" />

        <TextView
            android:id="@+id/contrast_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/contrast_slider"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.slider.Slider
            android:id="@+id/contrast_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/video_adjustments_contrast"
            android:stepSize="1"
            android:value="0"
            android:valueFrom="-100"
            android:valueTo="100"
            app:labelBehavior="floating" />

        <TextView
            android:id="@+id/saturation_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/saturation_slider"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.slider.Slider
            android:id="@+id/saturation_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/video_adjustments_saturation"
            android:stepSize="1"
            android:value="100"
            android:valueFrom="0"
            android:valueTo="200"
            app:labelBehavior="floating" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/adjustments_remember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/video_adjustments_remember" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/video_adjustments_description"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
