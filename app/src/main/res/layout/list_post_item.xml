<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/itemAvatarView"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/post_author_avatar_content_description"
            android:src="@drawable/placeholder_person"
            app:shapeAppearance="@style/CircularImageView" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/itemAuthorView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="Channel name" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/itemDateView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="2 days ago · edited" />
        </LinearLayout>

        <ImageView
            android:id="@+id/itemPinnedView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/post_pinned_content_description"
            android:src="@drawable/ic_pin"
            android:visibility="gone" />
    </LinearLayout>

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/itemPostContentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="A channel post with text and a link." />

    <LinearLayout
        android:id="@+id/itemImagesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/itemPollContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemAttachmentCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOnSurfaceVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/itemAttachmentThumbnail"
                android:layout_width="128dp"
                android:layout_height="76dp"
                android:contentDescription="@string/post_attachment_thumbnail_content_description"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_thumbnail_video" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/itemAttachmentTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="Attached video title" />

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/itemAttachmentDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Attachment description" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/itemStatsView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="1.2K likes · 42 comments" />

        <Button
            android:id="@+id/itemOpenOriginalButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/open_original_post"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>
</LinearLayout>
