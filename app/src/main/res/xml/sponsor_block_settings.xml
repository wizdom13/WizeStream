<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="@string/sponsor_block_settings_key"
    android:title="@string/sponsor_block_settings_title">

    <Preference
        android:key="@string/sponsor_block_home_page_key"
        android:summary="@string/sponsor_block_home_page_summary"
        android:title="@string/sponsor_block_home_page_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="@string/sponsor_block_privacy_key"
        android:summary="@string/sponsor_block_privacy_summary"
        android:title="@string/sponsor_block_privacy_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:title="@string/sponsor_block_settings_category_title"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/sponsor_block_enable_key"
            android:summary="@string/sponsor_block_enable_summary"
            android:title="@string/sponsor_block_enable_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="@string/sponsor_block_enable_key"
            android:key="@string/sponsor_block_graced_rewind_key"
            android:summary="@string/sponsor_block_graced_rewind_summary"
            android:title="@string/sponsor_block_graced_rewind_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="@string/sponsor_block_enable_key"
            android:key="@string/sponsor_block_notifications_key"
            android:summary="@string/sponsor_block_notifications_summary"
            android:title="@string/sponsor_block_notifications_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="@string/sponsor_block_enable_key"
            android:key="sponsor_block_full_video_labels"
            android:summary="@string/full_video_labels_summary"
            android:title="@string/full_video_labels_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <PreferenceScreen
            android:dependency="@string/sponsor_block_enable_key"
            android:fragment="org.schabi.newpipe.settings.SponsorBlockCategoriesSettingsFragment"
            android:key="@string/sponsor_block_categories_key"
            android:summary="@string/sponsor_block_categories_summary"
            android:title="@string/sponsor_block_categories_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/sb_contribute_title"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="sponsor_block_contributions"
            android:title="@string/sb_contribute_enable"
            android:summary="@string/sb_contribute_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />
        <EditTextPreference
            android:dependency="sponsor_block_contributions"
            android:key="sponsor_block_contribution_id"
            android:persistent="false"
            android:title="@string/sb_contribute_identity"
            android:summary="@string/sb_contribute_identity_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/dearrow_settings_category_title"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/dearrow_enable_key"
            android:summary="@string/dearrow_enable_summary"
            android:title="@string/dearrow_enable_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="@string/dearrow_enable_key"
            android:key="@string/dearrow_titles_key"
            android:summary="@string/dearrow_titles_summary"
            android:title="@string/dearrow_titles_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="@string/dearrow_enable_key"
            android:key="@string/dearrow_thumbnails_key"
            android:summary="@string/dearrow_thumbnails_summary"
            android:title="@string/dearrow_thumbnails_title"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
